# Copy to .env (or export directly) and fill in your own credentials.
# .env is git-ignored; never commit real keys.

# LLM used for schema linking, summarisation and the pairwise judge.
# Any OpenAI-compatible endpoint works.
ALICLOUD_API_KEY=
ALICLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/

# Same credential, as consumed by individual stages:
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
JUDGE_API_KEY=
JUDGE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional experiment tracking. Leave empty and set WANDB_MODE=disabled to skip.
WANDB_API_KEY=
# WANDB_MODE=disabled
