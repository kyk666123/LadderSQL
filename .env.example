# Copy to .env (or export directly) and fill in your own credentials.
# .env is git-ignored; never commit real keys.

# LLM used for schema linking, summarisation and the pairwise judge.
# Any OpenAI-compatible endpoint works. NOTE the model-name string is provider-specific:
#   SiliconFlow -> zai-org/GLM-5.2   (our validated provider)
#   DashScope   -> glm-5.2
# run_test.sh derives GLM_MODEL from JUDGE_API_BASE; set it explicitly only for other providers.
ALICLOUD_API_KEY=
ALICLOUD_BASE_URL=https://api.siliconflow.cn/v1

# Same credential, as consumed by individual stages:
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
JUDGE_API_KEY=
JUDGE_API_BASE=https://api.siliconflow.cn/v1
# GLM_MODEL=zai-org/GLM-5.2

# Optional experiment tracking. Leave empty and set WANDB_MODE=disabled to skip.
WANDB_API_KEY=
# WANDB_MODE=disabled
